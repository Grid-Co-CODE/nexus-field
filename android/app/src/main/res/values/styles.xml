<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      Os parágrafos do termo de uso e privacidade da localização (TermoDaEquipe): o texto no tamanho da mensagem de um
      diálogo do AppCompat, e o título de cada seção (em negrito pelo <b> do strings.xml) com um respiro em cima, que
      separa uma seção da outra. Em sp, pelo TextAppearance: a fonte grande do sistema aumenta o texto, e ele rola.
    -->
    <style name="TermoDaEquipe.Texto" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:paddingTop">4dp</item>
    </style>

    <style name="TermoDaEquipe.Titulo" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:paddingTop">16dp</item>
    </style>


    <!--
      A abertura do Nexus Field: o navy do ícone com o G pequeno no centro. O Android 12+ desenha a abertura sozinho
      com os dois windowSplashScreen*; o Theme.SplashScreen do androidx faz o mesmo desenho do 7 ao 11 (o fundo da
      janela). Sem eles, o padrão do androidx é o fundo do tema e o ícone genérico do Android.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icone</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>