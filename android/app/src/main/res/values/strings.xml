<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!--
      O aplicativo se chama Nexus Field (pedido do dono da casca, 17/10/2026); o site que ele abre continua sendo o App
      de Campo. Texto da casca que fala do aplicativo diz Nexus Field (o testes/nome.test.mjs confere).
    -->
    <!-- Nome que aparece em Configurações > Apps. -->
    <string name="app_name">Nexus Field</string>
    <!-- Rótulo do ícone na tela inicial: o launcher usa o da activity. -->
    <string name="title_activity_main">Nexus Field</string>
    <!-- O applicationId (o Capacitor escreve os dois no cap add). -->
    <string name="package_name">br.com.gridco.nexusfield</string>
    <string name="custom_url_scheme">br.com.gridco.nexusfield</string>

    <!--
      Os diálogos da casca. Vão ao campo, e os textos estão PENDENTES de aprovação do dono da casca na prévia
      (docs/previas/telas.html), também os que passaram a dizer Nexus Field em 17/10/2026. Quando ele aprovar, esta
      nota passa a dizer "aprovados", com a data; daí em diante não se muda texto sem nova prévia.
    -->

    <!-- Primeira abertura: pede a câmera, a localização precisa e (Android 13+) as notificações. -->
    <string name="casca_permissoes_titulo">Antes de começar</string>
    <string name="casca_permissoes_texto">O Nexus Field usa a câmera para as fotos das OS e das rondas, a localização precisa para registrar onde o serviço começou e terminou e as notificações para avisar das tarefas do dia e das emergências.</string>
    <string name="casca_permissoes_continuar">Continuar</string>

    <!-- Quem já tinha o Nexus Field e atualizou para a 1.1.0 (Android 13+) vê este aviso antes de o Android pedir a
         notificação. Texto novo de 18/10/2026, PENDENTE de aprovação do dono da casca na prévia. Em 19/10/2026 o "na
         hora" virou "em poucos minutos (sem som fora do expediente)": a emergência chega em até 10 minutos e, fora do
         dia útil e do expediente, sem som (spec 2026-10-18, seção 1); "na hora" prometia mais, e o técnico que visse a das
         18h chegar muda acharia que o alarme quebrou. -->
    <string name="casca_avisos_titulo">Avisos do Nexus Field</string>
    <string name="casca_avisos_texto">O Nexus Field avisa às 7h e às 13h o que você tem para fazer e, em poucos minutos, quando surgir uma emergência (sem som fora do expediente). Toque em Permitir na próxima tela.</string>
    <string name="casca_avisos_continuar">Continuar</string>

    <!-- O técnico escolheu a localização aproximada (Android 12+). -->
    <string name="casca_aproximada_titulo">Localização precisa desligada</string>
    <string name="casca_aproximada_texto">Com a localização aproximada, a posição vem com erro de quilômetros e o Nexus Field não consegue registrar o início e o fim do serviço. Nos ajustes, toque em Permissões &gt; Localização e ligue Usar localização precisa.</string>

    <!-- A câmera ou a localização negadas. -->
    <string name="casca_negadas_titulo">Permissões necessárias</string>
    <string name="casca_negadas_texto">Sem a câmera e a localização, o Nexus Field não consegue registrar as OS. Nos ajustes, toque em Permissões e libere Câmera e Localização.</string>

    <string name="casca_abrir_ajustes">Abrir ajustes</string>
    <string name="casca_agora_nao">Agora não</string>

    <!-- A WebView sem o script de início antes da página (DOCUMENT_START_SCRIPT). -->
    <string name="casca_webview_titulo">Atualize o Android System WebView</string>
    <string name="casca_webview_texto">O Nexus Field precisa de uma versão mais nova do componente que mostra as telas. Atualize o Android System WebView na Play Store e abra o Nexus Field de novo.</string>
    <string name="casca_webview_abrir_loja">Abrir a Play Store</string>

    <!--
      A atualização da casca (spec, seção 7). Mesma regra: texto PENDENTE de aprovação do dono da casca na prévia.
      O texto da versão leva o versionName e uma linha "- item" por novidade do versao.json; o "_simples" é o caso de
      uma Release sem nenhuma novidade (não aparece "Novidades:" com a lista vazia).
    -->
    <string name="casca_atualizacao_titulo">Nova versão do Nexus Field</string>
    <string name="casca_atualizacao_texto">Versão %1$s. Novidades:\n%2$s</string>
    <string name="casca_atualizacao_texto_simples">Versão %1$s.</string>
    <string name="casca_atualizacao_atualizar">Atualizar agora</string>
    <string name="casca_atualizacao_depois">Depois</string>

    <!-- O toque em "Atualizar agora": o download começou (toast). PENDENTE de aprovação do dono da casca na prévia (texto
         novo de 17/10/2026, que o plano não previa). -->
    <string name="casca_atualizacao_baixando">Baixando a versão nova…</string>

    <!-- O Android pede a permissão "Instalar apps desconhecidos" para este app antes de abrir o instalador. -->
    <string name="casca_instalar_titulo">Permitir a atualização</string>
    <string name="casca_instalar_texto">Para instalar a versão nova, libere Instalar apps desconhecidos para o Nexus Field e volte para cá.</string>

    <!-- O arquivo baixado não bateu com o SHA-256 do versao.json (toast). -->
    <string name="casca_atualizacao_sha_toast">Não consegui conferir o arquivo da atualização. Tento de novo mais tarde.</string>

    <!--
      Os canais das notificações (spec 2026-10-18), com os nomes que o técnico vê nos ajustes do Android (Apps > Nexus
      Field > Notificações) e ao segurar uma notificação. PENDENTES de aprovação do dono da casca na prévia, no quadro
      dos ajustes da seção Notificações (#t-canais). Os ids (resumo, emergencia, emergencia_silenciosa) são o contrato
      com o servidor e ficam no código (Notificacoes); só o nome sai daqui. Prefixo próprio, não casca_: não são diálogo
      nem toast. O testes/previas.test.mjs confere que os três estão no quadro e que são os do CanaisDeNotificacao.
    -->
    <string name="notificacao_canal_resumo">Resumo do dia</string>
    <string name="notificacao_canal_emergencia">Emergências</string>
    <string name="notificacao_canal_emergencia_silenciosa">Emergências fora do expediente</string>

    <!--
      O atalho de teste dos avisos, só para administrador (decisão do dono, 18/10/2026): o toque longo no ícone do Nexus
      Field mostra estes dois atalhos só na conta que o servidor diz Admin, e cada um pede ao servidor um aviso de teste
      no canal dele (o alto e o silencioso), junto com um resumo de teste, que toca com o som normal no canal do resumo:
      por isso nenhum rótulo promete "sem som", e o "sem alarme" é o da emergência de teste, que vem no canal silencioso.
      O launcher mostra o rótulo longo quando cabe (até uns 25 caracteres) e o curto quando não cabe (o do atalho fixado
      na tela inicial), cortado a uns 10. O "_desligado" é o que o launcher mostra no toque do atalho fixado que ficou
      desligado (a conta não é Admin, ou saiu). Rótulos de 19/10/2026 ("Testar" e "Testar avisos"; "Sem alarme" e "Testar
      sem alarme", no lugar de "Silencioso" e "Testar avisos fora do expediente", que passava dos 25), PENDENTES de
      aprovação do dono da casca na prévia (o quadro #t-atalhos). Prefixo próprio, não casca_: não são diálogo nem toast.
      O testes/previas.test.mjs confere que são os do AtalhosDeTeste, e o AtalhosDeTesteTest, o tamanho.
    -->
    <string name="atalho_teste_avisos_curto">Testar</string>
    <string name="atalho_teste_avisos_longo">Testar avisos</string>
    <string name="atalho_teste_fora_curto">Sem alarme</string>
    <string name="atalho_teste_fora_longo">Testar sem alarme</string>
    <string name="atalho_teste_desligado">Só para administrador</string>

    <!-- O resultado do teste pedido pelo atalho (toast). Sem dado da conta: só a contagem de aparelhos. O "(s)" fica, e
         não um plurals: no pt-BR o Android põe o 0 no singular ("0 aparelho"), e o 0 é o caso que a prova procura (o
         aparelho que não se registrou). Textos novos de 18/10/2026 (o "_sem_contagem", o 200 cuja contagem não se lê, e o
         "_ja_pedido", o segundo toque em menos de 10 s, de 19/10/2026), PENDENTES de aprovação do dono da casca na
         prévia. -->
    <string name="casca_teste_enviado">Aviso de teste enviado para %1$d aparelho(s)</string>
    <string name="casca_teste_enviado_sem_contagem">Aviso de teste enviado</string>
    <string name="casca_teste_so_admin">Só administrador pode testar</string>
    <string name="casca_teste_entrar">Entre no Nexus Field para testar</string>
    <string name="casca_teste_falhou">Não consegui enviar o teste agora</string>
    <string name="casca_teste_ja_pedido">Teste já pedido. Espere alguns segundos para pedir outro</string>
</resources>
