    -->
    <string name="notificacao_canal_inicio_do_dia">Início do dia</string>
    <string name="notificacao_inicio_titulo">Bom dia</string>
    <string name="notificacao_inicio_texto">Toque para abrir o Nexus Field e começar o dia.</string>

