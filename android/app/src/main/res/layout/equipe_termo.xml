<?xml version="1.0" encoding="utf-8"?>
<!--
  O termo de uso e privacidade da localização da equipe dentro do diálogo (TermoDaEquipe, R11): o texto rola e o Li e
  aceito, que é o botão do diálogo, fica sempre à vista embaixo. A rolagem tem o peso: o diálogo do AppCompat dá ao meio a
  altura que sobra do título e dos botões, e ela fica com essa altura menos a da dica. Os parágrafos (um por linha do
  texto) entram em equipe_termo_secoes pelo código. A barra de rolagem fica à vista e os indicadores de cima e de baixo
  aparecem enquanto houver texto naquela direção: é o que diz ao técnico que há mais para ler.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/equipe_termo_rolagem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:scrollIndicators="top|bottom"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/equipe_termo_secoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="?attr/dialogPreferredPadding"
            android:paddingEnd="?attr/dialogPreferredPadding"
            android:paddingBottom="16dp" />
    </ScrollView>

    <!-- Enquanto o Li e aceito está desligado, logo acima dele; sai quando ele liga. -->
    <TextView
        android:id="@+id/equipe_termo_dica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/dialogPreferredPadding"
        android:paddingTop="12dp"
        android:paddingEnd="?attr/dialogPreferredPadding"
        android:text="@string/casca_equipe_termo_rolar"
        android:textAppearance="@style/TextAppearance.AppCompat.Caption" />
</LinearLayout>
