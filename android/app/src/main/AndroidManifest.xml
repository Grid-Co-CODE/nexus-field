<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      allowBackup=false e as regras de dados: os nomes das chaves guardadas no aparelho têm e-mail de técnico, e nada
      disso pode ir para o backup da nuvem nem para a cópia de aparelho a aparelho (spec, seção 6.4).
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_dados"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          A porta interna da MainActivity (MainActivity.PORTA_INTERNA): por ela chegam o toque na notificação (o
          PendingIntent é do próprio app) e o atalho de teste dos avisos (o launcher abre o atalho em nome do app), e só
          o Intent que chega por ela leva a OS (gc_os) ou o teste (gc_teste) à página. NÃO exportada e sem filtro:
          nenhum outro app a alcança. A MainActivity, exportada pelo ícone, ignora esses extras. Vem depois da activity
          (a alias exige o alvo declarado antes) e herda dela o singleTask.
        -->
        <activity-alias
            android:name=".PortaInterna"
            android:targetActivity=".MainActivity"
            android:exported="false" />

        <!--
          Este é o provider do template do Capacitor, e fica: o BridgeWebChromeClient procura exatamente
          "<pacote>.fileprovider" para entregar à câmera o arquivo da foto do <input capture>, a reserva da câmera
          interna do App. Sem ele, essa reserva quebra.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          O segundo provider, só para o instalador da atualização da casca (spec, seção 7): expõe apenas
          cache/atualizacao/, nada além. Tem subclasse própria porque, para o sistema, dois <provider> com o mesmo
          android:name são o mesmo componente, e um plugin que declare o FileProvider de novo conflita na mesclagem.
          (Medido em 16/10/2026: o AGP 8.13.0 aceita os dois com a mesma classe no mesmo arquivo; a subclasse é
          prevenção, não correção de erro.) A autoridade sai do applicationId, como a do outro: o Atualizador a monta
          com o BuildConfig.APPLICATION_ID.
        -->
        <provider
            android:name=".ArquivosProvider"
            android:authorities="${applicationId}.arquivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/caminhos_arquivos" />
        </provider>

        <!--
          As notificações (spec 2026-10-18): o servidor do App de Campo manda pelo Firebase só mensagens de dados, e é este
          serviço que monta e mostra a notificação (MensagensDoFirebase, Notificacoes), com o app aberto ou fechado. Não
          exportado: o Firebase o chama por dentro do app; exportado, qualquer app do aparelho poderia mandar uma
          "emergência". Ele vence o serviço padrão do Firebase, que vem com prioridade -500 no mesmo filtro.
        -->
        <service
            android:name=".MensagensDoFirebase"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          A coleta da posição da equipe (spec 2026-11-08): um serviço em primeiro plano do tipo localização, com a
          notificação fixa, das 6h às 22h, também com o app fechado (ServicoDaEquipe). Não exportado e sem filtro: só a
          casca o liga (e, no dia já começado, com o tempo todo, o religamento do sistema e o ReceptorDoInicio, R15), e
          nenhum outro app o alcança.
        -->
        <service
            android:name=".ServicoDaEquipe"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          O aviso das 6h (R12, AvisoDoInicio): o alarme das 6h chega aqui e mostra o aviso; o boot, a atualização do app,
          o fuso novo e o relógio mudado reagendam o alarme (o Android não o guarda de um boot para o outro), e o boot e a
          atualização também religam a coleta do dia já começado (R15). Não exportado: o alarme é
          um PendingIntent explícito do próprio app, e os quatro eventos vêm do sistema, que alcança o receptor não
          exportado (o exported só barra os outros apps). Assim nenhum app de fora manda um "Bom dia" a qualquer hora. A
          ação do alarme fica fora do filtro.
        -->
        <receiver
            android:name=".ReceptorDoInicio"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!--
          Se um dia chegar uma mensagem com notificação (e não só dados), o próprio Firebase a mostra: no canal do resumo
          (o mais calmo dos três), e não no "Miscellaneous" que ele criaria, e com o G branco no lugar do quadrado cinza.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="resumo" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacao" />
    </application>

    <!-- Permissions -->

    <!-- Sem ACCESS_NETWORK_STATE o navigator.onLine fica sempre true e o evento "online", que dispara a sincronização, nunca vem. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Precisa da localização precisa: a aproximada erra por quilômetros e o "esquentar" do GPS não termina. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Para abrir o instalador do sistema na atualização da casca. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 13+: sem ela, nem o resumo nem a emergência aparecem. É pedida em tempo de execução. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A coleta da equipe (spec 2026-11-08): o serviço em primeiro plano (Android 9+) do tipo localização (Android 14+),
         com a localização durante o uso (as duas de cima), que a casca pede logo depois do termo de uso: o serviço iniciado
         com o app à vista a mantém enquanto roda, também com o app fechado. Sem a localização precisa o mapa mostra o
         técnico como "sem permissão". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- A "o tempo todo" (R15, no lugar da R10, que a tinha tirado): a casca a pede logo depois da localização dada, uma vez
         por conta. Com ela a coleta do dia já começado pela abertura volta sozinha (o processo que o Android matou, o
         celular reiniciado, o app atualizado); do Android 14 em diante, o primeiro plano de localização ligado com o app no
         fundo a exige. Recusada, a coleta segue só com a durante o uso, como na 1.2.0. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- O celular acordado durante o envio dos pontos (ServicoDaEquipe): com a tela apagada ele dorme entre uma posição e
         outra. O Firebase também a traz, mas a coleta não fica dependendo de outra biblioteca para tê-la. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- O aviso das 6h (AvisoDoInicio): o alarme volta depois de o celular religar, e a coleta do dia começado também
         (R15). O alarme é inexato (o setAndAllowWhileIdle), e por isso nem SCHEDULE_EXACT_ALARM nem USE_EXACT_ALARM
         entram. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- A janela do próprio Android que pede a bateria sem restrição (R15, EquipeNaCasca), logo depois do termo de uso, da
         localização e do tempo todo, uma vez por conta: liberado da otimização de bateria, o Android 12+ deixa religar a
         coleta com o app no fundo, e o HyperOS fecha menos o app. O BatteryLife do lint fala da regra da loja do Google, e o Nexus
         Field não é da loja (sai pela Release do GitHub). -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Sem o required="false", a permissão CAMERA faz a câmera parecer obrigatória (lint
         PermissionImpliesUnsupportedChromeOsHardware). As duas são pedidas em tempo de execução. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Android 11+: sem isto o app não enxerga o app de câmera para a foto e o vídeo do <input capture>. -->
    <!-- E a Segurança do HyperOS: o toque no aviso do que falta abre a tela do Início automático só se a enxergar. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>
</manifest>
